{
  "name": "mc-launcher",
  "version": "1.0.0",
  "description": "Custom Minecraft launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.mclauncher",
    "productName": "MC Launcher",
    "files": ["main.js", "preload.js", "renderer/**", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "MC-Launcher-Setup-${version}.exe"
    },
    "portable": { "artifactName": "MC-Launcher-Portable-${version}.exe" }
  }
}
